# ==============================================================================
# ARC 11 ARCHITECT — WHATSAPP AUTOMATION & AI PLATFORM
# Environment Configuration Template (.env.example)
# ==============================================================================

# Database Connection (Dedicated PostgreSQL DB on Windows Server)
DATABASE_URL="postgresql://postgres:PASSWORD@YOUR_WINDOWS_SERVER_IP:5432/arc11architect?schema=public&sslmode=prefer"

# Application Settings
NODE_ENV="production"
PORT=3011
NEXT_PUBLIC_APP_URL="https://whatsapp.arc11architect.com"
NEXT_PUBLIC_BUSINESS_NAME="ARC 11 Architect"

# Security & Authentication
JWT_SECRET="generate_a_strong_random_jwt_secret"
COOKIE_SECRET="generate_a_strong_random_cookie_secret"

# Meta WhatsApp Cloud API Configuration
# (Obtain from Meta Developers Dashboard -> WhatsApp -> API Setup)
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_ACCESS_TOKEN="YOUR_SYSTEM_USER_PERMANENT_ACCESS_TOKEN"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WABA_ID"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="YOUR_CUSTOM_WEBHOOK_VERIFY_TOKEN"
META_WEBHOOK_SECRET="YOUR_META_WEBHOOK_APP_SECRET"
# Set only for local automated tests. Prevents outbound messages from reaching Meta.
WHATSAPP_DRY_RUN="false"

# AI Provider Settings (Modular: mock-rules, openai, gemini, anthropic)
AI_PROVIDER="mock-rules"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=350
AI_TEMPERATURE=0.3
